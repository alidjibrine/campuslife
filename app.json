{
  "expo": {
    "name": "CampusLife",
    "slug": "campuslife",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "campuslife",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alidjibrine.campuslife"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.alidjibrine.campuslife"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F3EE",
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "alidjibrine",
    "backgroundColor": "#F5F3EE"
  }
}
