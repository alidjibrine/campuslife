{
  "expo": {
    "name": "CampusLife",
    "slug": "campuslife",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "campuslife",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F3EE",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alidjibrine.campuslife",
      "icon": "./assets/icon.png"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.alidjibrine.campuslife",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F3EE"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "CampusLife accède à tes photos uniquement pour que tu choisisses ta photo de profil.",
          "cameraPermission": "CampusLife accède à ton appareil photo uniquement si tu choisis de prendre une photo de profil."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F5F3EE"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "alidjibrine"
  }
}
